#include "mt7621.dtsi"

#include <dt-bindings/input/input.h>

/ {
	compatible = "mediatek,mt7621-rfb-ax-nand", "mediatek,mt7621-soc";
	model = "ELECOM WTC-X1800GC";

	keys {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "gpio-keys";
		
		reset {
			label = "reset";
			gpios = <&gpio 6 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		switch {
			label = "modeswitch";
			gpios = <&gpio 7 GPIO_ACTIVE_LOW>;
			linux,code = <0x03>;
		};

		wps {
			label = "wps_btn";
			gpios = <&gpio 18 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};
	};

	leds: leds {
		compatible = "gpio-leds";

		led_power_green: power_green {
			gpios = <&gpio 3 GPIO_ACTIVE_HIGH>;
			label = "green:power";
		};

		led_power_red: power_red {
			default-state = "on";
			gpios = <&gpio 4 GPIO_ACTIVE_HIGH>;
			label = "red:power";
		};
	};
};

&ethernet {
	status = "okay";
};

&switch0 {
	port@5 {
		phy-mode = "rgmii";
		reg = <5>;

		fixed-link {
			full-duplex;
			speed = <1000>;
		};
	};

	port@6 {
		phy-mode = "trgmii";
	};
};

&gmac0 {
	phy-mode = "trgmii";
};

&gmac1 {
	label = "wan";
	status = "okay";
};

&uartlite2 {
	status = "okay";
};

&pcie {
	status = "okay";
};

&pcie0 {
	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;
		mediatek,mtd-eeprom = <&factory 0x0000>;

		led {
			led-sources = <0>;
			led-active-low;
		};
	};
};

&pcie1 {
	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;
		mediatek,mtd-eeprom = <&factory 0x8000>;

		led {
			led-sources = <0>;
			led-active-low;
		};
	};
};


&nand {
	status = "okay";

	flash@0 {
		nand-ecc-mode = "hw";
		reg = <0>;

		partitions {
			#address-cells = <1>;
			#size-cells = <1>;
			compatible = "fixed-partitions";

			All@0 {
				label = "All";
				read-only;
				reg = <0x00 0x7f80000>;
			};

			partition@0 {
				label = "Bootloader";
				reg = <0x00 0x100000>;
			};

			partition@100000 {
				label = "Ubootenv";
				reg = <0x100000 0x100000>;
			};

			factory: partition@200000 {
				label = "Factory";
				reg = <0x200000 0x1c0000>;
			};

			partition@3600000 {
				label = "Config";
				reg = <0x3600000 0x100000>;
			};

			partition@3700000 {
				label = "RAS2";
				reg = <0x3700000 0x3240000>;
			};

			partition@3740000 {
				label = "firmware";
				reg = <0x3700000 0x3240000>;
			};

			partition@3C0000 {
				label = "RAS1";
				reg = <0x3c0000 0x3240000>;
			};

			partition@400000 {
				label = "firmware_now";
				reg = <0x3c0000 0x3240000>;
			};

			partition@6940000 {
				label = "Config_2";
				reg = <0x6940000 0x100000>;
			};

			partition@6A40000 {
				label = "persist";
				reg = <0x6a40000 0x100000>;
			};

			partition@6B40000 {
				label = "mesh";
				reg = <0x6b40000 0x100000>;
			};

			partition@6C40000 {
				label = "Backup";
				reg = <0x6c40000 0x1340000>;
			};
		};
	};
};