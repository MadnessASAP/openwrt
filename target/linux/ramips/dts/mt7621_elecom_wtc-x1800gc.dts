#include "mt7621.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "elecom,xts-x1800gc", "mediatek,mt7621-soc";
	model = "ELECOM WRC-1900GST";

  leds: leds {
		compatible = "gpio-leds";

		led_power_green: power_green {
			function = LED_FUNCTION_POWER;
      color = <LED_COLOR_ID_GREEN>;
			label = "green:power";
			gpios = <&gpio 0x03 GPIO_ACTIVE_HIGH>;
		};

		power_red {
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_RED>;
			label = "red:power";
			gpios = <&gpio 0x04 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};
	};

  keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&gpio 0x06 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		wps {
			label = "wps_btn";
			gpios = <&gpio 0x12 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};

		switch {
			label = "modeswitch";
			gpios = <&gpio 0x07 GPIO_ACTIVE_LOW>;
			linux,code = <0x03>;
		};
	};
};

&gmac1 {
	status = "okay";
	label = "lan";
	phy-handle = <&ethphy0>;
};

&nand {
  status = "okay";

  flash@0 {
    reg = <0x00>;
    nand-ecc-mode = "hw";

    partitions {
      compatible = "fixed-partitions";
      #address-cells = <0x01>;
      #size-cells = <0x01>;

      partition@0 {
        label = "u-boot";
        reg = <0x00 0x100000>;
      };

      partition@100000 {
        label = "u-boot-env";
        reg = <0x100000 0x100000>;
      };

      factory: partition@200000 {
        label = "factory";
        reg = <0x200000 0x1c0000>;
        read-only;
        
        nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					eeprom_factory_0: eeprom@0 {
						reg = <0x0 0x4da8>;
					};

					eeprom_factory_8000: eeprom@8000 {
						reg = <0x8000 0x4da8>;
					};
				};
      };

      partition@400000 {
        label = "firmware_now";
        reg = <0x3c0000 0x3240000>;
      };

      partition@3600000 {
        label = "Config";
        reg = <0x3600000 0x100000>;
      };

      partition@3740000 {
        label = "firmware";
        reg = <0x3700000 0x3240000>;
      };

      partition@6940000 {
        label = "Config_2";
        reg = <0x6940000 0x100000>;
      };

      partition@6A40000 {
        label = "persist";
        reg = <0x6a40000 0x100000>;
      };

      partition@6B40000 {
        label = "mesh";
        reg = <0x6b40000 0x100000>;
      };

      partition@6C40000 {
        label = "Backup";
        reg = <0x6c40000 0x1340000>;
      };

      partition@3C0000 {
        label = "RAS1";
        reg = <0x3c0000 0x3240000>;
      };

      partition@3700000 {
        label = "RAS2";
        reg = <0x3700000 0x3240000>;
      };
    };
  };
};

&gmac0 {
	nvmem-cells = <&macaddr_factory_e000>;
	nvmem-cell-names = "mac-address";
};

&gmac1 {
	nvmem-cells = <&macaddr_factory_e006>;
	nvmem-cell-names = "mac-address";
};

&factory {
	nvmem-layout {
		compatible = "fixed-layout";
		#address-cells = <1>;
		#size-cells = <1>;

		macaddr_factory_e000: macaddr@e000 {
			reg = <0xe000 0x6>;
		};

		macaddr_factory_e006: macaddr@e006 {
			reg = <0xe006 0x6>;
		};
	};
};
