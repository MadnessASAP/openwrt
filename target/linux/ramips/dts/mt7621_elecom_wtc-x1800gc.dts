#include "mt7621.dtsi"

#include <dt-bindings/input/input.h>

/ {
	compatible = "elecom,wtc-x1800gc", "mediatek,mt7621-soc";
	model = "ELECOM WTC-X1800GC";

	keys {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "gpio-keys";
		
		reset {
			label = "reset";
			gpios = <&gpio 6 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		repeater {
			label = "repeater";
			gpios = <&gpio 7 GPIO_ACTIVE_LOW>;
			linux,code = <BTN_0>;
			linux,input-type = <EV_SW>;
		};

		wps {
			label = "wps";
			gpios = <&gpio 18 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};
	};

	leds: leds {
		compatible = "gpio-leds";

		led_power_green: power_green {
			gpios = <&gpio 3 GPIO_ACTIVE_HIGH>;
			label = "green:power";
		};

		led_power_red: power_red {
			default-state = "on";
			gpios = <&gpio 4 GPIO_ACTIVE_HIGH>;
			label = "red:power";
		};
	};
};

&ethernet {
	status = "okay";
};

&switch0 {
	port@5 {
		phy-mode = "rgmii";
		reg = <5>;

		fixed-link {
			full-duplex;
			speed = <1000>;
		};
	};

	port@6 {
		phy-mode = "trgmii";
	};
};

&gmac0 {
	phy-mode = "trgmii";
	nvmem-cells = <&macaddr_factory_1fdfa>;
	nvmem-cell-names = "mac-address";
};

&gmac1 {
	status = "okay";
	label = "wan";
	phy-handle = <&ethphy0>;

	nvmem-cells = <&macaddr_factory_1fdf4>;
	nvmem-cell-names = "mac-address";
};

&mdio {
	ethphy0: ethernet-phy@0 {
		reg = <0>;
	};
};

&uartlite2 {
	status = "okay";
};

&pcie {
	status = "okay";
};

&pcie0 {
	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;
		mediatek,mtd-eeprom = <&factory 0x0000>;

		led {
			led-sources = <0>;
			led-active-low;
		};
	};
};

&pcie1 {
	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;
		mediatek,mtd-eeprom = <&factory 0x8000>;

		led {
			led-sources = <0>;
			led-active-low;
		};
	};
};


&nand {
	status = "okay";

	flash@0 {
		nand-ecc-mode = "hw";
		reg = <0>;

		partitions {
			#address-cells = <1>;
			#size-cells = <1>;
			compatible = "fixed-partitions";

			All@0 {
				label = "All";
				read-only;
				reg = <0x00 0x7f80000>;
			};

			partition@0 {
				label = "Bootloader";
				reg = <0x00 0x100000>;
			};

			partition@100000 {
				label = "Ubootenv";
				reg = <0x100000 0x100000>;
			};

			factory: partition@200000 {
				label = "Factory";
				reg = <0x200000 0x1c0000>;
			};

			partition@3c0000 {
				label = "firmware";
				reg = <0x3c0000 0x3340000>;

				compatible = "fixed-partitions";
				#address-cells = <1>;
				#size-cells = <1>;

				partition@0 {
					label = "kernel";
					reg = <0x4000 0x380000>;
				};

				partition@800000 {
					label = "ubi";
					reg = <0x3C0000 0x2E80000>;
				};
			};

			partition@3700000 {
				label = "firmware2";
				reg = <0x3700000 0x3240000>;
			};

			partition@6940000 {
				label = "Config_2";
				reg = <0x6940000 0x100000>;
			};

			partition@6A40000 {
				label = "persist";
				reg = <0x6a40000 0x100000>;
			};

			partition@6B40000 {
				label = "mesh";
				reg = <0x6b40000 0x100000>;
			};

			partition@6C40000 {
				label = "Backup";
				reg = <0x6c40000 0x1340000>;
			};
		};
	};
};

&factory {
	compatible = "nvmem-cells";
	#address-cells = <1>;
	#size-cells = <1>;

	macaddr_factory_1fdfa: macaddr@1fdfa {
		reg = <0x1fdfa 0x6>;
	};

	macaddr_factory_1fdf4: macaddr@1fdf4 {
		reg = <0x1fdf4 0x6>;
	};
};